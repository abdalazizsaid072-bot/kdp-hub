{
  "name": "KDP Hub — إدارة أعمال النشر",
  "short_name": "KDP Hub",
  "description": "إدارة عملاء النشر على أمازون كيندل، الترجمة والتنسيق، الأغلفة وتصميمات 3D، Amazon Ads والتحليلات",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./#/home",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0a17",
  "theme_color": "#0b0a17",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "عميل جديد", "url": "./#/projects", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "عرض سعر", "url": "./#/tools?t=quote", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "التحليلات", "url": "./#/analytics", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
